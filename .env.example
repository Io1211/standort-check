# Backend only. Never prefix any of these with VITE_ – that would ship them to the browser.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# The direct connection (port 5432) is IPv6-only and does not work from Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Admin login (single account)
ADMIN_EMAIL=sales@example.com
# bcrypt hash, create with: go run ./cmd/hashpw  (password is read from stdin)
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Confirmation email after a successful form submission (backend only).
# Set both values here locally and in the Vercel environment for deployment.
# EMAIL_FROM must be a sender address configured in Brevo, e.g. standort@example.com.
BREVO_API_KEY=
EMAIL_FROM=

# Geo enrichment (optional). Free key: https://myprojects.geoapify.com (3,000 requests/day).
# Without a key, leads are stored normally but not geocoded.
GEOAPIFY_API_KEY=
# Service area as comma-separated German federal states (as Geoapify names them).
SERVICE_AREA_STATES=Sachsen,Hamburg,Schleswig-Holstein

# Session cookies always use Secure; admin access requires HTTPS or a browser-supported localhost exception.
