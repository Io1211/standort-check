# Backend only. Never prefix any of these with VITE_ – that would ship them to the browser.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# The direct connection (port 5432) is IPv6-only and does not work from Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Admin login (single account)
ADMIN_EMAIL=sales@example.com
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Brevo transactional email
BREVO_API_KEY=
EMAIL_FROM=

# Local only: set to "production" to force Secure cookies. On Vercel, VERCEL_ENV is used.
APP_ENV=development
